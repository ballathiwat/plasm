// prisma/schema.prisma
// Plasm — ระบบจัดการคลังพลาสมา

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ผู้ใช้ระบบ =====
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pinHash        String?   @map("pin_hash")
  pinFailCount   Int       @default(0) @map("pin_fail_count")
  pinLockedUntil DateTime? @map("pin_locked_until")

  extVerified    ExtDocument[] @relation("ExtVerifier")
  extStored      ExtDocument[] @relation("ExtStorer")
  extApproved    ExtDocument[] @relation("ExtApprover")
  extCreated     ExtDocument[] @relation("ExtCreatedBy")
  extExports     ExtExport[]
  extTimeline    ExtTimeline[]
  extCommittee   ExtCommittee[]
  extAttachments ExtAttachment[]
  logs         LogEntry[]
  unitRemovals UnitRemoval[]
  slotLocks    SlotLock[]

  @@map("users")
}

enum Role {
  ADMIN
  STAFF
}

enum BoxStatus {
  STORED
  WITHDRAWN
}

// ===== หน่วยพลาสมา (Unit) ในกล่อง =====
model Unit {
  id         String     @id @default(cuid())
  unitNumber String     @unique @map("unit_number")
  boxId      String     @map("box_id")
  status      UnitStatus @default(STORED)
  seq         Int?       // ลำดับถุงในกล่อง 1 = หน้า (ฝาเปิด) … 10 = หลัง
  withdrawnAt DateTime?  @map("withdrawn_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  box Box @relation(fields: [boxId], references: [id])

  @@index([unitNumber])
  @@map("units")
}

enum UnitStatus {
  STORED
  WITHDRAWN
}

// ===== บันทึกการลบ unit ออกจากกล่อง (ต้องระบุหมายเหตุทุกครั้ง) =====
model UnitRemoval {
  id         String   @id @default(cuid())
  unitNumber String   @map("unit_number")
  boxId      String   @map("box_id")
  boxLabel   String   @map("box_label")
  note       String
  userId     String?  @map("user_id")
  removedAt  DateTime @default(now()) @map("removed_at")

  box  Box   @relation(fields: [boxId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([unitNumber])
  @@index([boxId])
  @@map("unit_removals")
}

// ===== ประวัติการทำงาน =====
model LogEntry {
  id        String    @id @default(cuid())
  action    LogAction
  boxId     String?   @map("box_id")
  detail    String
  unitCount Int       @default(0) @map("unit_count")   // เพิ่ม
  userId    String?   @map("user_id")
  timestamp DateTime  @default(now())
  createdAt DateTime  @default(now()) @map("created_at")

  box  Box?  @relation(fields: [boxId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp(sort: Desc)])
  @@map("log_entries")
}

enum LogAction {
  STORE
  WITHDRAW
  EDIT
}

// ===== ตั้งค่าระบบ =====
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("settings")
}

// ===== Master data =====
model MasterPlasmaType {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String?
  color  String? 
  active Boolean @default(true)
  sort   Int     @default(0)
  boxes        Box[]
  extDocuments ExtDocument[]

  @@map("master_plasma_types")
}

model MasterBloodType {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String?
  color  String?   
  active Boolean @default(true)
  sort   Int     @default(0)
  boxes  Box[]

  @@map("master_blood_types")
}

model MasterZone {
  id        String        @id @default(cuid())
  name      String        @unique
  legacyKey String?       @unique @map("legacy_key") // ROOM / CABINET ใช้ map ข้อมูลเดิมตอนเฟส 2
  active    Boolean       @default(true)
  sort      Int           @default(0)
  shelves   MasterShelf[]
  boxes Box[]
  slotLocks SlotLock[]


  @@map("master_zones")
}

model MasterShelf {
  id     String     @id @default(cuid())
  zoneId String     @map("zone_id")
  code   String
  active Boolean    @default(true)
  sort   Int        @default(0)
  zone   MasterZone @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, code])
  @@map("master_shelves")
}

// หมายเหตุการลบ unit (กำหนดจากเมนูตั้งค่า)
model MasterRemovalReason {
  id     String  @id @default(cuid())
  name   String  @unique
  active Boolean @default(true)
  sort   Int     @default(0)

  @@map("master_removal_reasons")
}

// เฟส 2 จะใช้รันเลขกล่อง
model BoxCounter {
  plasmaTypeId String @map("plasma_type_id")
  bloodTypeId  String @map("blood_type_id")
  year         Int
  lastNo       Int    @default(0) @map("last_no")

  @@id([plasmaTypeId, bloodTypeId, year])
  @@map("box_counters")
}

model Box {
  id             String    @id @default(cuid())
  boxLabel       String    @unique @map("box_label")
  boxName        String?   @map("box_name")
  type           String
  blood          String
  plasmaTypeId   String    @map("plasma_type_id")
  bloodTypeId    String    @map("blood_type_id")
  year           Int
  zoneId         String    @map("zone_id")
  shelf          String
  level          Int?      // ชั้นใน rack 1–5 (1 = บนสุด) — เฉพาะห้อง -30°C
  position       Int?      // ช่องในชั้น 1–20 — เฉพาะห้อง -30°C
  collectionDate DateTime  @map("collection_date") @db.Date
  status         BoxStatus @default(STORED)
  storedAt       DateTime  @default(now()) @map("stored_at")
  withdrawnAt    DateTime? @map("withdrawn_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  plasmaType MasterPlasmaType @relation(fields: [plasmaTypeId], references: [id])
  bloodType  MasterBloodType  @relation(fields: [bloodTypeId], references: [id])
  zone       MasterZone       @relation(fields: [zoneId], references: [id])
  units      Unit[]
  logs       LogEntry[]
  removals   UnitRemoval[]

  @@index([blood, status])
  @@index([bloodTypeId, status])
  @@index([zoneId, shelf])
  @@map("boxes")


}

// ===== ล็อกช่อง rack ระหว่างมีคนแก้ไข (TTL 60s) =====
// unique (zone, shelf, level, position) — กล่องในช่องเดียวกันกันด้วย partial index ใน migration
model SlotLock {
  id        String   @id @default(cuid())
  zoneId    String   @map("zone_id")
  shelf     String
  level     Int
  position  Int
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  zone MasterZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([zoneId, shelf, level, position])
  @@index([expiresAt])
  @@map("slot_locks")
}

// ═════════════════════════════════════════════════════════════
//  External Blood Receiving (รับเลือดจากภายนอก)
// ═════════════════════════════════════════════════════════════

enum ExtDocStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  EXPORTED
  CANCELLED
}

enum ExtBagStatus {
  IN_STOCK
  EXPORTED
}

model ExtSource {
  id        String        @id @default(cuid())
  name      String        @unique
  locked    Boolean       @default(false)
  active    Boolean       @default(true)
  sort      Int           @default(0)
  documents ExtDocument[]
  @@map("ext_sources")
}

model ExtStorage {
  id        String        @id @default(cuid())
  name      String        @unique
  active    Boolean       @default(true)
  sort      Int           @default(0)
  documents ExtDocument[]
  @@map("ext_storages")
}

// ExtBloodProduct ถูกยุบรวมเข้า MasterPlasmaType แล้ว (migration 20261114)

model ExtExportReason {
  id      String      @id @default(cuid())
  name    String      @unique
  active  Boolean     @default(true)
  sort    Int         @default(0)
  exports ExtExport[]
  @@map("ext_export_reasons")
}

model ExtDocument {
  id             String       @id @default(cuid())
  docNumber      String       @unique @map("doc_number")
  receivedDate   DateTime     @map("received_date") @db.Date
  sourceId       String       @map("source_id")
  bloodProductId String       @map("blood_product_id")
  bloodGroup     String       @map("blood_group")
  boxLabel       String       @map("box_label")
  storageId      String       @map("storage_id")
  status         ExtDocStatus @default(DRAFT)
  editReason     String?      @map("edit_reason")
  deferApproval  Boolean      @default(false) @map("defer_approval")
  verifierId     String?      @map("verifier_id")
  verifiedAt     DateTime?    @map("verified_at")
  verifierPin    Boolean      @default(false) @map("verifier_pin")
  storerId       String?      @map("storer_id")
  storedAt       DateTime?    @map("stored_at")
  storerPin      Boolean      @default(false) @map("storer_pin")
  approverId     String?      @map("approver_id")
  approvedAt     DateTime?    @map("approved_at")
  approverPin    Boolean      @default(false) @map("approver_pin")
  rejectReason   String?      @map("reject_reason")
  submittedAt    DateTime?    @map("submitted_at")
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  source       ExtSource       @relation(fields: [sourceId], references: [id])
  bloodProduct MasterPlasmaType @relation(fields: [bloodProductId], references: [id])
  storage      ExtStorage      @relation(fields: [storageId], references: [id])
  verifier     User?           @relation("ExtVerifier", fields: [verifierId], references: [id])
  storer       User?           @relation("ExtStorer", fields: [storerId], references: [id])
  approver     User?           @relation("ExtApprover", fields: [approverId], references: [id])
  createdBy    User?           @relation("ExtCreatedBy", fields: [createdById], references: [id])
  bags         ExtBag[]
  attachments  ExtAttachment[]
  timeline     ExtTimeline[]
  exports      ExtExport[]
  committee    ExtCommittee[]

  @@map("ext_documents")
}

model ExtBag {
  id         String       @id @default(cuid())
  documentId String       @map("document_id")
  bagNumber  String       @map("bag_number")
  status     ExtBagStatus @default(IN_STOCK)
  exportedAt DateTime?    @map("exported_at")
  exportId   String?      @map("export_id")

  document ExtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  export   ExtExport?  @relation(fields: [exportId], references: [id])

  @@unique([bagNumber])
  @@map("ext_bags")
}

model ExtAttachment {
  id         String      @id @default(cuid())
  documentId String      @map("document_id")
  fileName   String      @map("file_name")
  fileType   String      @map("file_type")
  fileSize   Int         @map("file_size")
  filePath   String      @map("file_path")
  createdAt  DateTime    @default(now()) @map("created_at")
  // รูปที่เพิ่มหลังเอกสารอนุมัติแล้ว (รูปเดิมทั้งหมด = false)
  isPostApproval Boolean @default(false) @map("is_post_approval")
  uploadedById   String? @map("uploaded_by_id")

  document   ExtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("ext_attachments")
}

model ExtExport {
  id         String          @id @default(cuid())
  documentId String          @map("document_id")
  reasonId   String          @map("reason_id")
  exportDate DateTime        @map("export_date") @db.Date
  note       String?
  userId     String?         @map("user_id")
  createdAt  DateTime        @default(now()) @map("created_at")

  document ExtDocument     @relation(fields: [documentId], references: [id])
  reason   ExtExportReason @relation(fields: [reasonId], references: [id])
  user     User?           @relation(fields: [userId], references: [id])
  bags     ExtBag[]

  @@map("ext_exports")
}

model ExtTimeline {
  id         String      @id @default(cuid())
  documentId String      @map("document_id")
  action     String
  detail     String
  userId     String?     @map("user_id")
  createdAt  DateTime    @default(now()) @map("created_at")

  document ExtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id])

  @@map("ext_timeline")
}

model ExtDocCounter {
  year   Int
  lastNo Int @default(0) @map("last_no")

  @@id([year])
  @@map("ext_doc_counters")
}

// ===== คณะกรรมการอนุมัติ (1 คนทำได้หลายหน้าที่, อนุมัติพร้อมกันได้) =====
enum ExtCommitteeRole {
  VERIFIER
  STORER
  APPROVER
}

enum ExtCommitteeStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model ExtCommittee {
  id         String             @id @default(cuid())
  documentId String             @map("document_id")
  userId     String             @map("user_id")
  role       ExtCommitteeRole
  status     ExtCommitteeStatus @default(DRAFT)
  reason     String?
  actedAt    DateTime?          @map("acted_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  document ExtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id])

  @@unique([documentId, userId, role])
  @@index([userId, status])
  @@map("ext_committee")
}
