// prisma/schema.prisma
// Plasm — ระบบจัดการคลังพลาสมา

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ผู้ใช้ระบบ =====
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(STAFF)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  logs LogEntry[]

  @@map("users")
}

enum Role {
  ADMIN
  STAFF
}

enum BoxStatus {
  STORED
  WITHDRAWN
}

// ===== หน่วยพลาสมา (Unit) ในกล่อง =====
model Unit {
  id         String     @id @default(cuid())
  unitNumber String     @unique @map("unit_number")
  boxId      String     @map("box_id")
  status     UnitStatus @default(STORED)
  createdAt  DateTime   @default(now()) @map("created_at")

  box Box @relation(fields: [boxId], references: [id])

  @@index([unitNumber])
  @@map("units")
}

enum UnitStatus {
  STORED
  WITHDRAWN
}

// ===== ประวัติการทำงาน =====
model LogEntry {
  id        String    @id @default(cuid())
  action    LogAction
  boxId     String?   @map("box_id")
  detail    String
  unitCount Int       @default(0) @map("unit_count")   // เพิ่ม
  userId    String?   @map("user_id")
  timestamp DateTime  @default(now())
  createdAt DateTime  @default(now()) @map("created_at")

  box  Box?  @relation(fields: [boxId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp(sort: Desc)])
  @@map("log_entries")
}

enum LogAction {
  STORE
  WITHDRAW
  EDIT
}

// ===== ตั้งค่าระบบ =====
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("settings")
}

// ===== Master data =====
model MasterPlasmaType {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String?
  color  String? 
  active Boolean @default(true)
  sort   Int     @default(0)
  

  @@map("master_plasma_types")
}

model MasterBloodType {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String?
  color  String?   
  active Boolean @default(true)
  sort   Int     @default(0)
  boxes  Box[]

  @@map("master_blood_types")
}

model MasterZone {
  id        String        @id @default(cuid())
  name      String        @unique
  legacyKey String?       @unique @map("legacy_key") // ROOM / CABINET ใช้ map ข้อมูลเดิมตอนเฟส 2
  active    Boolean       @default(true)
  sort      Int           @default(0)
  shelves   MasterShelf[]
  boxes Box[]


  @@map("master_zones")
}

model MasterShelf {
  id     String     @id @default(cuid())
  zoneId String     @map("zone_id")
  code   String
  active Boolean    @default(true)
  sort   Int        @default(0)
  zone   MasterZone @relation(fields: [zoneId], references: [id])

  @@unique([zoneId, code])
  @@map("master_shelves")
}

// เฟส 2 จะใช้รันเลขกล่อง
model BoxCounter {
  plasmaTypeId String @map("plasma_type_id")
  bloodTypeId  String @map("blood_type_id")
  year         Int
  lastNo       Int    @default(0) @map("last_no")

  @@id([plasmaTypeId, bloodTypeId, year])
  @@map("box_counters")
}

model Box {
  id             String    @id @default(cuid())
  boxLabel       String    @unique @map("box_label")
  boxName        String?   @map("box_name")
  type           String
  blood          String
  plasmaTypeId   String    @map("plasma_type_id")
  bloodTypeId    String    @map("blood_type_id")
  year           Int
  zoneId         String    @map("zone_id")
  shelf          String
  collectionDate DateTime  @map("collection_date") @db.Date
  status         BoxStatus @default(STORED)
  storedAt       DateTime  @default(now()) @map("stored_at")
  withdrawnAt    DateTime? @map("withdrawn_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  plasmaType MasterPlasmaType @relation(fields: [plasmaTypeId], references: [id])
  bloodType  MasterBloodType  @relation(fields: [bloodTypeId], references: [id])
  zone       MasterZone       @relation(fields: [zoneId], references: [id])
  units      Unit[]
  logs       LogEntry[]

  @@index([blood, status])
  @@index([bloodTypeId, status])
  @@index([zoneId, shelf])
  @@map("boxes")


}

